# Anthropic API Key (get yours at https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model to use (claude-3-5-sonnet-20241022 or claude-3-5-haiku-20241022)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Maximum number of unread emails to process per run
MAX_EMAILS=5

# Optional: Your name to sign off in drafts (e.g. Vaibhav)
USER_NAME=Vaibhav
